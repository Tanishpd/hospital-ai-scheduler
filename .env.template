# Environment Configuration Template
# Copy this file to .env and fill in your actual values

# LLM Configuration (FREE - No API key needed!)
# This implementation uses a mock LLM for demonstration
# No costs involved - completely free to run!
LLM_TYPE=mock_free

# Email Configuration (optional)
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password_here

# Database Configuration
DATABASE_URL=sqlite:///appointments.db

# Application Settings
DEBUG=True
SECRET_KEY=your_secret_key_here

# External API Keys (for future integrations)
GOOGLE_CALENDAR_API_KEY=your_google_calendar_api_key
TWILIO_ACCOUNT_SID=your_twilio_sid_for_sms
TWILIO_AUTH_TOKEN=your_twilio_token_for_sms

# Healthcare Provider Information
CLINIC_NAME=Healthcare Center
CLINIC_PHONE=(555) 123-4567
CLINIC_EMAIL=appointments@healthcarecenter.com
CLINIC_ADDRESS=123 Healthcare Ave, Medical City, MC 12345
